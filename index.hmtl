<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>The Equivalent W-2 Salary</title>
<style>
  :root {
    --paper:#f5f0e6; --ink:#1d1b17; --muted:#6f675a; --accent:#8a2f25;
    --line:#d8cfbe; --card:#fbf8f1;
    --serif:'Iowan Old Style','Palatino Linotype',Palatino,'Book Antiqua',Georgia,serif;
    --mono:ui-monospace,'SF Mono',Menlo,Consolas,monospace;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:var(--serif);
         padding:22px 16px 60px; }
  .wrap { max-width:640px; margin:0 auto; }
  .kicker { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--accent); font-family:var(--mono); }
  h1 { font-size:30px; line-height:1.1; margin:6px 0 4px; font-weight:700; }
  .lede { color:var(--muted); font-size:14px; margin:0 0 22px; max-width:480px; }
  .panel { background:var(--card); border:1px solid var(--line); border-radius:4px; padding:18px 18px 20px; }
  .label { font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); font-family:var(--mono); margin-bottom:6px; }
  .hint { font-size:12px; color:var(--muted); margin-bottom:6px; }
  .inputbox { display:flex; align-items:center; border:1px solid var(--line); border-radius:3px; background:#fff; padding:0 12px; }
  .inputbox span { font-family:var(--mono); color:#9a9082; font-size:16px; }
  .inputbox input { flex:1; border:none; outline:none; font-family:var(--mono); font-size:18px;
                    color:var(--ink); padding:11px 8px; background:transparent; width:100%; -moz-appearance:textfield; }
  input[type=number]::-webkit-outer-spin-button, input[type=number]::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
  .gap { height:16px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:3px; overflow:hidden; }
  .seg button { flex:1; padding:11px 8px; border:none; cursor:pointer; background:#fff; color:var(--ink);
                font-family:var(--mono); font-size:13px; transition:background .15s; }
  .seg button + button { border-left:1px solid var(--line); }
  .seg button.on { background:var(--accent); color:#fff; }
  .toggle { display:flex; align-items:center; gap:10px; background:none; border:none; cursor:pointer; padding:0; color:var(--ink); font-family:var(--serif); margin-top:18px; text-align:left; }
  .track { width:42px; height:24px; border-radius:12px; background:var(--line); position:relative; transition:background .2s; flex-shrink:0; }
  .track.on { background:var(--accent); }
  .knob { position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:var(--card); transition:left .2s; }
  .track.on .knob { left:20px; }
  .tg-title { font-size:14px; font-weight:600; }
  .tg-sub { display:block; font-size:12px; color:var(--muted); }
  .hero { background:var(--ink); color:var(--paper); border-radius:4px; padding:22px 20px; margin:16px 0; text-align:center; }
  .hero .k { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:#c9a99a; font-family:var(--mono); }
  .hero .big { font-size:44px; font-weight:700; font-family:var(--mono); line-height:1.1; margin:6px 0 2px; }
  .hero .sub { font-size:13px; color:#c9a99a; }
  .cards { display:grid; grid-template-columns:1fr; gap:14px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:4px; padding:16px 18px; }
  .card h3 { font-size:14px; font-weight:700; margin:0 0 10px; }
  .row { display:flex; justify-content:space-between; align-items:baseline; padding:6px 0; border-bottom:1px solid var(--line); }
  .row .rl { color:var(--muted); font-size:13px; }
  .row .rv { font-family:var(--mono); font-size:14px; font-weight:500; }
  .row.strong .rv { font-size:16px; font-weight:700; }
  .row .neg { color:var(--accent); }
  .note { font-size:12px; color:var(--muted); margin-top:8px; line-height:1.5; }
  .foot { font-size:11.5px; color:var(--muted); line-height:1.6; margin-top:20px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="kicker">Contractor → Employee</div>
  <h1>The Equivalent W-2 Salary</h1>
  <p class="lede">What to pay someone as a salaried employee so their take-home matches what they net today as a 1099 contractor. 2026 figures.</p>
 
  <div class="panel">
    <div class="label">Current annual 1099 pay</div>
    <div class="inputbox"><span>$</span><input id="pay" type="number" step="1000" value="120000" /></div>
 
    <div class="gap"></div>
    <div class="label">Filing status</div>
    <div class="seg" id="status">
      <button data-v="single" class="on">Single</button>
      <button data-v="mfj">Married / joint</button>
    </div>
 
    <div class="gap"></div>
    <div class="label">State income tax (effective %)</div>
    <div class="inputbox"><input id="stateRate" type="number" step="0.1" value="5" /><span>%</span></div>
 
    <div class="gap"></div>
    <div class="label">Benefits you'll provide (annual value)</div>
    <div class="hint">Health premiums, 401(k) match, etc. that they currently pay themselves. Lowers the salary needed.</div>
    <div class="inputbox"><span>$</span><input id="benefits" type="number" step="500" value="0" /></div>
 
    <button class="toggle" id="qbiBtn">
      <span class="track on" id="qbiTrack"><span class="knob"></span></span>
      <span>
        <span class="tg-title">Contractor gets the QBI deduction</span>
        <span class="tg-sub">20% pass-through deduction. Turn off for high-income service businesses past the phase-out.</span>
      </span>
    </button>
  </div>
 
  <div class="hero">
    <div class="k">Pay them as W-2 salary</div>
    <div class="big" id="salary">$0</div>
    <div class="sub" id="salaryDelta"></div>
  </div>
 
  <div class="cards">
    <div class="card">
      <h3>Their take-home — as a 1099 contractor</h3>
      <div id="c1099"></div>
    </div>
    <div class="card">
      <h3>Their take-home — at the W-2 salary above</h3>
      <div id="cw2"></div>
    </div>
    <div class="card">
      <h3>Your cost as the employer</h3>
      <div id="cemp"></div>
    </div>
  </div>
 
  <p class="foot">Estimate only, not tax advice. Uses 2026 federal brackets and the $184,500 Social Security wage base; state tax is approximated as a flat effective rate (real state rules vary, and some don't follow the federal QBI or SE-tax deductions). Assumes no business expenses carry over to the W-2 role. Run real numbers past a CPA before making an offer.</p>
</div>
 
<script>
  const SS_WAGE_BASE = 184500, SS_RATE = 0.062, MEDI_RATE = 0.0145, ADDL_MEDI_RATE = 0.009, SE_FACTOR = 0.9235;
  const STD_DED = { single: 16100, mfj: 32200 };
  const ADDL_MEDI_THRESHOLD = { single: 200000, mfj: 250000 };
  const BRACKETS = {
    single: [[0,0.1],[12400,0.12],[50400,0.22],[105700,0.24],[201775,0.32],[256225,0.35],[640600,0.37]],
    mfj: [[0,0.1],[24800,0.12],[100800,0.22],[211400,0.24],[403550,0.32],[512450,0.35],[768700,0.37]]
  };
 
  const usd = n => "$" + Math.round(n).toLocaleString("en-US");
 
  function fedTax(taxable, status) {
    if (taxable <= 0) return 0;
    const b = BRACKETS[status]; let tax = 0;
    for (let i = 0; i < b.length; i++) {
      const lower = b[i][0], upper = i + 1 < b.length ? b[i + 1][0] : Infinity;
      if (taxable > lower) tax += (Math.min(taxable, upper) - lower) * b[i][1]; else break;
    }
    return tax;
  }
  function compute1099(pay, status, sr, qbi) {
    const seBase = pay * SE_FACTOR;
    const ss = Math.min(seBase, SS_WAGE_BASE) * 0.124;
    const medi = seBase * 0.029;
    const addl = Math.max(0, seBase - ADDL_MEDI_THRESHOLD[status]) * ADDL_MEDI_RATE;
    const seTax = ss + medi + addl, halfSE = (ss + medi) / 2, agi = pay - halfSE;
    const preQBI = Math.max(0, agi - STD_DED[status]);
    const qbiDed = qbi ? Math.min(0.2 * Math.max(0, agi), 0.2 * preQBI) : 0;
    const fed = fedTax(Math.max(0, preQBI - qbiDed), status);
    const state = sr * Math.max(0, pay - halfSE);
    return { seTax, fed, state, net: pay - seTax - fed - state };
  }
  function computeW2(salary, status, sr) {
    const ss = Math.min(salary, SS_WAGE_BASE) * SS_RATE, medi = salary * MEDI_RATE;
    const addl = Math.max(0, salary - ADDL_MEDI_THRESHOLD[status]) * ADDL_MEDI_RATE;
    const empFICA = ss + medi + addl;
    const fed = fedTax(Math.max(0, salary - STD_DED[status]), status);
    const state = sr * salary;
    return { empFICA, fed, state, net: salary - empFICA - fed - state };
  }
  const employerFICA = s => Math.min(s, SS_WAGE_BASE) * SS_RATE + s * MEDI_RATE;
 
  function row(label, val, opts = {}) {
    const neg = opts.neg ? "neg" : "", strong = opts.strong ? "strong" : "";
    const sign = opts.neg ? "−" : "";
    return `<div class="row ${strong}"><span class="rl">${label}</span><span class="rv ${neg}">${sign}${usd(Math.abs(val))}</span></div>`;
  }
 
  let status = "single", qbi = true;
 
  function render() {
    const pay = parseFloat(document.getElementById("pay").value) || 0;
    const sr = (parseFloat(document.getElementById("stateRate").value) || 0) / 100;
    const benefits = parseFloat(document.getElementById("benefits").value) || 0;
 
    const r1099 = compute1099(pay, status, sr, qbi);
    const targetNet = r1099.net - benefits;
    let lo = 0, hi = pay * 2 + 200000;
    for (let i = 0; i < 60; i++) {
      const mid = (lo + hi) / 2;
      if (computeW2(mid, status, sr).net < targetNet) lo = mid; else hi = mid;
    }
    const salary = (lo + hi) / 2;
    const rW2 = computeW2(salary, status, sr);
    const employerCost = salary + employerFICA(salary) + benefits;
 
    document.getElementById("salary").textContent = usd(salary);
    document.getElementById("salaryDelta").textContent =
      salary > pay ? usd(salary - pay) + " above the 1099 figure"
      : salary < pay ? usd(pay - salary) + " below the 1099 figure"
      : "same as the 1099 figure";
 
    document.getElementById("c1099").innerHTML =
      row("Gross pay", pay) + row("Self-employment tax (15.3%)", r1099.seTax, {neg:1}) +
      row("Federal income tax", r1099.fed, {neg:1}) + row("State income tax", r1099.state, {neg:1}) +
      row("Net take-home", r1099.net, {strong:1}) +
      (benefits > 0 ? `<div class="note">…out of which they pay ~${usd(benefits)} for their own benefits.</div>` : "");
 
    document.getElementById("cw2").innerHTML =
      row("Salary", salary) + row("Employee payroll tax (7.65%)", rW2.empFICA, {neg:1}) +
      row("Federal income tax", rW2.fed, {neg:1}) + row("State income tax", rW2.state, {neg:1}) +
      row("Net take-home", rW2.net, {strong:1}) +
      (benefits > 0 ? `<div class="note">+ ${usd(benefits)} in employer benefits = equivalent to their 1099 net.</div>` : "");
 
    const more = employerCost > pay;
    document.getElementById("cemp").innerHTML =
      row("Salary", salary) + row("Employer payroll tax (7.65%)", employerFICA(salary), {neg:1}) +
      (benefits > 0 ? row("Benefits provided", benefits, {neg:1}) : "") +
      row("Total cost", employerCost, {strong:1}) +
      `<div class="note">You pay ${usd(pay)} today as a contractor. This W-2 arrangement costs <strong style="color:${more ? 'var(--accent)' : 'var(--ink)'}">${usd(Math.abs(employerCost - pay))} ${more ? 'more' : 'less'}</strong> per year — the price of covering half their payroll tax${benefits > 0 ? ' and their benefits' : ''}.</div>`;
  }
 
  document.querySelectorAll("#status button").forEach(b => b.addEventListener("click", () => {
    status = b.dataset.v;
    document.querySelectorAll("#status button").forEach(x => x.classList.remove("on"));
    b.classList.add("on");
    render();
  }));
  document.getElementById("qbiBtn").addEventListener("click", () => {
    qbi = !qbi;
    document.getElementById("qbiTrack").classList.toggle("on", qbi);
    render();
  });
  ["pay", "stateRate", "benefits"].forEach(id =>
    document.getElementById(id).addEventListener("input", render));
 
  render();
</script>
</body>
</html>
